{
  "name": "@aiursoft/utctime.js",
  "version": "1.0.8",
  "description": "Auto utc time",
  "main": "dist/cjs/utctime.js",
  "module": "dist/esm/utctime.js",
  "types": "dist/types/utctime.d.ts",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build-js": "tsc -b ./tsconfig.json ./tsconfig.types.json && tsc -p ./tsconfig.json --module commonjs --outDir ./dist/cjs",
    "build": "npm run build-js",
    "format": "prettier --write .",
    "lint": "eslint src/ --ext .ts && prettier --check .",
    "lint-fix": "eslint src/ --ext .ts --fix && prettier --write .",
    "check": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AiursoftWeb/utctime.js"
  },
  "devDependencies": {
    "esbuild": "^0.19.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "author": "Anduin Xue <anduin@aiursoft.com>",
  "license": "MIT"
}
